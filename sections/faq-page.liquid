{% schema %}
{
  "name": "FAQ Page",
  "settings": [],
  "presets": [{ "name": "FAQ Page" }]
}
{% endschema %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "When will my order ship?", "acceptedAnswer": { "@type": "Answer", "text": "Orders process in 1–2 business days and ship via USPS Priority or UPS Ground. Delivery: 3–7 business days. You'll get a tracking number the moment it leaves our warehouse." } },
    { "@type": "Question", "name": "Is packaging discreet?", "acceptedAnswer": { "@type": "Answer", "text": "Always. Every order ships in a plain outer box with no logos, no product descriptions, no indication of contents. Return address reads FL Logistics." } },
    { "@type": "Question", "name": "Do you ship internationally?", "acceptedAnswer": { "@type": "Answer", "text": "Currently we ship to all 50 US states. International shipping is not available at this time." } },
    { "@type": "Question", "name": "How much is shipping?", "acceptedAnswer": { "@type": "Answer", "text": "Free shipping on all orders over $75. Standard shipping on orders under $75 is calculated at checkout based on your location." } },
    { "@type": "Question", "name": "What's your return policy?", "acceptedAnswer": { "@type": "Answer", "text": "Returns accepted on unopened, unused items within 30 days. We can't accept used pieces for hygiene reasons. Contact us with your order number to start a return." } },
    { "@type": "Question", "name": "What does the 1-Year Guarantee cover?", "acceptedAnswer": { "@type": "Answer", "text": "Manufacturing defects, joint failures, and stress cracks under normal use. Doesn't cover drops. Email us with your order number and photos and we'll take care of you." } },
    { "@type": "Question", "name": "What is borosilicate glass?", "acceptedAnswer": { "@type": "Answer", "text": "Laboratory-grade glass known for thermal resistance and durability. Significantly stronger than regular glass and handles temperature changes without cracking. Chemically inert — it doesn't react with heat or leach chemicals. Every piece we carry uses it." } },
    { "@type": "Question", "name": "Do you have a rewards program?", "acceptedAnswer": { "@type": "Answer", "text": "Yes! Earn 1 point per $1 spent. Double points on Cat Collection items. Three tiers: Seedling, Sapling, and FLOW3R." } }
  ]
}
</script>

<div class="page-top">
  <nav class="breadcrumb"><a href="/">Home</a><span class="bc-sep">/</span><span class="bc-cur">FAQ &amp; Policies</span></nav>

  <div class="faq-header">
    <h1>FAQ &amp; Policies</h1>
    <p>Everything about ordering, shipping, returns, and warranties.</p>
  </div>

  <div class="faq-body">

    <div class="faq-accordion">

      <div class="faq-group-label" id="shipping">Shipping</div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          When will my order ship?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">Orders process in <strong>1–2 business days</strong> and ship via USPS Priority or UPS Ground. Delivery: 3–7 business days. You'll get a tracking number the moment it leaves our warehouse.</div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          Is packaging discreet?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">Always. Every order ships in a plain outer box with <strong>no logos, no product descriptions, no indication of contents.</strong> Return address reads "FL Logistics."</div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          Do you ship internationally?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">Currently we ship to all 50 US states. International shipping is not available at this time. We're working on it.</div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          How much is shipping?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner"><strong>Free shipping on all orders over $75.</strong> Standard shipping on orders under $75 is calculated at checkout based on your location.</div>
        </div>
      </div>

      <div class="faq-group-label" id="warranty">Returns &amp; Warranty</div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          What's your return policy?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">Returns accepted on <strong>unopened, unused items within 30 days.</strong> We can't accept used pieces for hygiene reasons. Contact us with your order number to start a return.</div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          What does the 1-Year Guarantee cover?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">Manufacturing defects, joint failures, and stress cracks under normal use. Doesn't cover drops. Email us with your order number and photos — <strong>we'll take care of you.</strong></div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          My item arrived damaged. What now?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">Don't dispose of packaging. Photograph the box and the piece. Email us within 48 hours — <strong>we'll ship a replacement at no cost.</strong></div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          Can I exchange for a different product?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">Yes, for unopened items in the return window. Reach out before returning so we can confirm availability and provide a return shipping label.</div>
        </div>
      </div>

      <div class="faq-group-label">Products &amp; Ordering</div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          What is borosilicate glass?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">Laboratory-grade glass known for thermal resistance and durability. <strong>Significantly stronger than regular glass</strong> and handles temperature changes without cracking. Chemically inert — it doesn't react with heat or leach chemicals. Every piece we carry uses it.</div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          Are your products for tobacco use only?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">All FLOW3R products are sold as <strong>tobacco smoking accessories</strong> for legal use in accordance with your local and state laws. By purchasing, you confirm you are 21+ and your intended use is legal.</div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          How do I clean my piece?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">Rinse with warm water after every session. For a deep clean, use 91%+ isopropyl alcohol and coarse salt — shake, soak, rinse. Check out our full <a href="/pages/glass-guide">Glass Guide</a> for step-by-step instructions.</div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          Do you have a rewards program?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">Yes! Earn 1 point per $1 spent. Double points on Cat Collection items. Three tiers: Seedling, Sapling, and FLOW3R. <a href="/pages/rewards">Learn more about rewards →</a></div>
        </div>
      </div>

    </div>

    <div class="contact-box">
      <div>
        <h3>Still have a question?</h3>
        <p>Our team is California-based and responds to every message personally. No bots.</p>
      </div>
      <a href="mailto:flow3r.shopp@gmail.com" class="contact-box-btn">Email Us →</a>
    </div>

  </div>
</div>
