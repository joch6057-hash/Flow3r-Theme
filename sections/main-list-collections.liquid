{% schema %}{"name":"Collections List","settings":[],"presets":[{"name":"Collections List"}]}{% endschema %}
<div class="page-top">
  <div class="breadcrumb"><a href="/">Home</a><span class="bc-sep">/</span><span class="bc-cur">Collections</span></div>
  <div style="padding:52px 44px 80px;background:#f6f5f2">
    <h1 style="font-size:36px;font-weight:800;margin-bottom:28px">All Collections</h1>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" style="background:#fff;border-radius:14px;overflow:hidden;text-decoration:none;border:1px solid rgba(0,0,0,.07);transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 8px 32px rgba(0,0,0,.1)'" onmouseout="this.style.boxShadow='none'">
          <div style="height:160px;background:#e8f5ed;display:flex;align-items:center;justify-content:center">
            {%- if collection.image -%}<img src="{{ collection.image | image_url: width: 400 }}" alt="{{ collection.title | escape }}" style="width:100%;height:100%;object-fit:cover">{%- endif -%}
          </div>
          <div style="padding:18px 20px">
            <div style="font-size:17px;font-weight:700;color:#0d0d0d;margin-bottom:4px">{{ collection.title }}</div>
            <div style="font-size:13px;color:#888">{{ collection.products_count }} product{{ collection.products_count | pluralize: '', 's' }}</div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>
