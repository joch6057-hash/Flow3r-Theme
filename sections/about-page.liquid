{% schema %}
{
  "name": "About Page",
  "settings": [],
  "presets": [{ "name": "About Page" }]
}
{% endschema %}

<div class="page-top">
  <nav class="breadcrumb"><a href="/">Home</a><span class="bc-sep">/</span><span class="bc-cur">About</span></nav>

  <!-- HERO -->
  <div class="ab-hero">
    <div class="ab-hero-label">✦ Our Story</div>
    <h1 class="ab-hero-h">Not a headshop.<br>A standard.</h1>
    <p class="ab-hero-sub">California-built. Daily-tested. No compromises.</p>
  </div>

  <!-- MANIFESTO STRIP -->
  <div class="ab-manifesto">
    <span>"We asked: why can't a bong be designed the way a good knife is?"</span>
  </div>

  <!-- THREE-COLUMN STORY -->
  <div class="ab-story">
    <div class="ab-story-col">
      <div class="ab-story-num">01</div>
      <div class="ab-story-label">The Problem</div>
      <p class="ab-story-p">Cheap imports break in two sessions. Artist pieces cost more than rent. Nothing in the middle was designed with intention — just sourced, boxed, and shipped.</p>
    </div>
    <div class="ab-story-col">
      <div class="ab-story-num">02</div>
      <div class="ab-story-label">The Standard</div>
      <p class="ab-story-p">Every piece we carry is hand-selected and tested. Thick borosilicate only. We spec joint sizes ourselves. If it doesn't earn a spot on our counter, it doesn't make the catalog.</p>
    </div>
    <div class="ab-story-col">
      <div class="ab-story-num">03</div>
      <div class="ab-story-label">The Commitment</div>
      <p class="ab-story-p">Small operation. Real people. We ship from California, stand behind every order with a 1-year guarantee, and put 10% of every Cat Collection sale directly into local cat shelters.</p>
    </div>
  </div>

  <!-- DARK STATS BAR -->
  <div class="ab-stats">
    <div class="ab-stat">
      <div class="ab-stat-num">100%</div>
      <div class="ab-stat-label">Borosilicate Glass</div>
    </div>
    <div class="ab-stat">
      <div class="ab-stat-num">CA</div>
      <div class="ab-stat-label">Based &amp; Operated</div>
    </div>
    <div class="ab-stat">
      <div class="ab-stat-num">1-Year</div>
      <div class="ab-stat-label">Guarantee</div>
    </div>
    <div class="ab-stat">
      <div class="ab-stat-num">10%</div>
      <div class="ab-stat-label">Cat Shelter Donations</div>
    </div>
  </div>

  <!-- CAT FAM SECTION -->
  <div class="ab-cat">
    <div class="ab-cat-inner">
      <div class="ab-cat-paw">🐾</div>
      <h2 class="ab-cat-h">The Cat Fam Initiative</h2>
      <p class="ab-cat-p">We love cats. Every Cat Collection purchase puts 10% directly into the hands of a local cat shelter. No overhead. No middleman. Real impact, every order.</p>
      <a href="/pages/cat-fam" class="btn btn-dk">Visit the Cat Fam Page</a>
    </div>
  </div>

  <!-- BOTTOM CTA -->
  <div class="ab-cta">
    <p class="ab-cta-label">✦ Ready to upgrade?</p>
    <h2 class="ab-cta-h">Built for people who care about what they use.</h2>
    <a href="/collections/all" class="btn btn-ol" style="font-size:15px;padding:13px 32px">Browse the Collection →</a>
  </div>

</div>
