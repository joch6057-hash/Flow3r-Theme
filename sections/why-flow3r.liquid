{% schema %}
{
  "name": "Why FLOW3R",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why FLOW3R?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "We built this because we were tired of choosing between glass that looked good and glass that worked." },
    { "type": "text", "id": "card1_title", "label": "Card 1 Title", "default": "Engineered Airflow" },
    { "type": "textarea", "id": "card1_text", "label": "Card 1 Text", "default": "Every downstem angle, chamber size, and joint spec is chosen for one reason — the cleanest, smoothest possible draw. We don't guess, we test." },
    { "type": "text", "id": "card2_title", "label": "Card 2 Title", "default": "Borosilicate Only" },
    { "type": "textarea", "id": "card2_text", "label": "Card 2 Text", "default": "Lab-grade glass — no acrylic, no soft plastics, no rubber that burns. Chemically inert at any temperature. What goes in is what comes out." },
    { "type": "text", "id": "card3_title", "label": "Card 3 Title", "default": "Clean is a Feature" },
    { "type": "textarea", "id": "card3_text", "label": "Card 3 Text", "default": "Every piece is designed for easy maintenance — wide bases, removable downstems, accessible chambers. Beautiful gear that doesn't become a chore to clean." }
  ],
  "presets": [{ "name": "Why FLOW3R" }]
}
{% endschema %}

<section class="home-section">
  <h2 class="sec-h">{{ section.settings.heading }}</h2>
  <p class="sec-sub">{{ section.settings.subheading }}</p>
  <div class="why-grid">
    <div class="why-card">
      <div class="why-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="8" stroke="rgba(36,80,52,.7)" stroke-width="1.5"/><path d="M11 6v5l3.5 2" stroke="rgba(36,80,52,.7)" stroke-width="1.5" stroke-linecap="round"/></svg>
      </div>
      <h3>{{ section.settings.card1_title }}</h3>
      <p>{{ section.settings.card1_text }}</p>
    </div>
    <div class="why-card">
      <div class="why-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="3" y="3" width="16" height="16" rx="3" stroke="rgba(36,80,52,.7)" stroke-width="1.5"/><path d="M6 11l3 3 7-6" stroke="rgba(36,80,52,.7)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h3>{{ section.settings.card2_title }}</h3>
      <p>{{ section.settings.card2_text }}</p>
    </div>
    <div class="why-card">
      <div class="why-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 2l2 5.5 5.5 1-4.5 4.5 1 6L11 16l-5 3 1-6L2.5 8.5 8 7.5z" stroke="rgba(36,80,52,.7)" stroke-width="1.5" fill="none"/></svg>
      </div>
      <h3>{{ section.settings.card3_title }}</h3>
      <p>{{ section.settings.card3_text }}</p>
    </div>
  </div>
</section>
