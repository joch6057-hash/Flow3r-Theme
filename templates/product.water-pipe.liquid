{%- comment -%}
  ══════════════════════════════════════════════════════════════
  product.water-pipe.liquid
  Flow3r — 8" Water Pipe / Dedicated Landing Page Template
  ──────────────────────────────────────────────────────────────
  CHANGES (May 2026):
    • Hero scroll hint now shows color swatches — clicking scrolls
      to #wpColorSection and selects the variant
    • Variant section is now two-column on desktop: image preview
      left, picker right. Image updates on swatch click.
    • Variant images pulled from variant.featured_image.
      If none assigned, shows placeholder.
  ══════════════════════════════════════════════════════════════
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign product_id = product.id -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {%- if product.description != blank -%}{{ product.description | strip_html | json }}{%- else -%}"Premium 8-inch borosilicate beaker water pipe with ice pinch and colored rim accents. California-based, 1-year guarantee, discreet plain packaging."{%- endif -%},
  "image": [
    {%- for image in product.images -%}
    "{{ image | image_url: width: 1200 }}"{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "brand": {
    "@type": "Brand",
    "name": "FLOW3R"
  },
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "url": "{{ shop.url }}{{ product.url }}?variant={{ variant.id }}",
      "price": "{{ variant.price | divided_by: 100.0 }}",
      "priceCurrency": "{{ shop.currency }}",
      "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition"
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>

<!---------------------- FONTS + BASE ----------------------->
<link href="https://api.fontshare.com/v2/css?f[]=neue-montreal@300,400,500,600,700&display=swap" rel="stylesheet">

<style>
/* ── RESET / SCOPE ─────────────────────────────────────── */
.wp-page *, .wp-page *::before, .wp-page *::after { box-sizing: border-box; margin: 0; padding: 0; }
.wp-page { font-family: 'Neue Montreal', system-ui, sans-serif; color: #0d0d0d; background: #fff; }
.wp-page img { display: block; }

/* ── CSS VARS (match flow3r-theme-v2) ─────────────────── */
.wp-page {
  --green:   #245034;
  --mint:    #e8f5ed;
  --text:    #0d0d0d;
  --muted:   #555550;
  --bg:      #ffffff;
  --bg2:     #f6f5f2;
  --radius:  4px;
  --max:     1280px;
}

/* ── IMAGE PLACEHOLDERS ────────────────────────────────── */
.f-ph {
  background: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
}
.f-ph::after {
  content: attr(data-label);
  color: #444;
  font-size: 10px;
  font-family: 'Neue Montreal', system-ui, sans-serif;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  font-weight: 500;
  position: absolute;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}

/* ── STICKY CART BAR ───────────────────────────────────── */
.wp-sticky {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: #0d0d0d;
  color: #fff;
  padding: 14px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 -4px 24px rgba(0,0,0,0.18);
}
.wp-sticky.visible { transform: translateY(0); }
.wp-sticky-left { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.wp-sticky-name { font-size: 13px; font-weight: 600; letter-spacing: 0.04em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.wp-sticky-price { font-size: 13px; color: #aaa; font-weight: 400; }
.wp-sticky-right { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.wp-sticky-swatches { display: flex; gap: 6px; }
.wp-swatch-mini {
  width: 18px; height: 18px;
  border-radius: 50%;
  border: 2px solid transparent;
  cursor: pointer;
  transition: border-color 0.15s;
}
.wp-swatch-mini.active { border-color: #fff; }
.wp-swatch-mini[data-color="Pink Rim"]  { background: #e8a0b0; }
.wp-swatch-mini[data-color="Blue Rim"]  { background: #7bafd4; }
.wp-swatch-mini[data-color="Green Rim"] { background: #245034; }
.wp-sticky-btn {
  background: var(--green, #245034);
  color: #fff;
  border: none;
  border-radius: var(--radius, 4px);
  font-family: 'Neue Montreal', system-ui, sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 11px 22px;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.2s, opacity 0.2s;
}
.wp-sticky-btn:hover { background: #1a3d26; }
.wp-sticky-btn:disabled { opacity: 0.5; cursor: not-allowed; }

/* ── HERO ──────────────────────────────────────────────── */
.wp-hero {
  position: relative;
  height: 92vh;
  min-height: 520px;
  max-height: 1100px;
  overflow: hidden;
  background: #111;
}
.wp-hero .f-ph { height: 100%; }
.wp-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.45) 0%, rgba(0,0,0,0.12) 28%, transparent 50%);
  pointer-events: none;
}
.wp-hero-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40px 24px 44px;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16px;
}
.wp-hero-eyebrow {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.65);
}
.wp-hero-title {
  font-size: clamp(32px, 8vw, 72px);
  font-weight: 300;
  line-height: 1.0;
  letter-spacing: -0.02em;
}
.wp-hero-title strong { font-weight: 600; }
.wp-hero-sub {
  font-size: 14px;
  color: rgba(255,255,255,0.7);
  font-weight: 400;
  max-width: 320px;
  line-height: 1.5;
}
.wp-hero-actions {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 4px;
}
.wp-hero-price {
  font-size: 22px;
  font-weight: 600;
  letter-spacing: -0.01em;
}
.wp-btn-primary {
  background: var(--green, #245034);
  color: #fff;
  border: none;
  border-radius: var(--radius, 4px);
  font-family: 'Neue Montreal', system-ui, sans-serif;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 14px 32px;
  cursor: pointer;
  transition: background 0.2s, transform 0.15s;
  display: inline-block;
}
.wp-btn-primary:hover { background: #1a3d26; transform: translateY(-1px); }
.wp-btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

/* ── SCROLL HINT + HERO SWATCHES ───────────────────────── */
.wp-scroll-hint {
  font-size: 11px;
  letter-spacing: 0.1em;
  color: rgba(255,255,255,0.4);
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 8px;
}
/* Animated vertical line — now a child element, not ::after */
.wp-scroll-line {
  display: block;
  width: 1px;
  height: 24px;
  background: rgba(255,255,255,0.3);
  animation: scrollLine 1.8s ease-in-out infinite;
  flex-shrink: 0;
}
@keyframes scrollLine { 0%,100% { opacity: 0.3; } 50% { opacity: 0.9; } }

/* Hero swatch cluster */
.wp-hero-swatches {
  display: flex;
  align-items: center;
  gap: 7px;
}
.wp-hero-swatch {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: none;
  outline: 1.5px solid transparent;
  outline-offset: 2px;
  cursor: pointer;
  padding: 0;
  transition: outline-color 0.15s, transform 0.12s;
  flex-shrink: 0;
}
.wp-hero-swatch:hover { transform: scale(1.2); }
.wp-hero-swatch.active { outline-color: rgba(255,255,255,0.85); }
.wp-hero-swatch[data-color="Pink Rim"]  { background: #e8a0b0; }
.wp-hero-swatch[data-color="Blue Rim"]  { background: #7bafd4; }
.wp-hero-swatch[data-color="Green Rim"] { background: #245034; outline: 1.5px solid rgba(255,255,255,0.25); outline-offset: 2px; }
.wp-hero-swatch[data-color="Green Rim"].active { outline-color: rgba(255,255,255,0.85); }

/* ── STATEMENT ─────────────────────────────────────────── */
.wp-statement {
  background: var(--bg2, #f6f5f2);
  padding: 64px 24px;
}
.wp-statement-inner {
  max-width: var(--max, 1280px);
  margin: 0 auto;
}
.wp-statement-text {
  font-size: clamp(22px, 5vw, 42px);
  font-weight: 300;
  line-height: 1.25;
  letter-spacing: -0.02em;
  max-width: 780px;
}
.wp-statement-text em { font-style: normal; font-weight: 600; }
.wp-statement-note {
  margin-top: 20px;
  font-size: 13px;
  color: var(--muted, #555550);
  font-weight: 400;
  letter-spacing: 0.01em;
}

/* ── LIFESTYLE GRID ────────────────────────────────────── */
.wp-lifestyle {
  padding: 0;
  overflow: hidden;
}
.wp-lifestyle-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
}
.wp-ls-tall { aspect-ratio: 4/5; }
.wp-ls-wide { aspect-ratio: 4/5; }
.wp-ls-sq   { aspect-ratio: 4/5; }

/* ── VARIANT SECTION ───────────────────────────────────── */
.wp-variants {
  padding: 40px 24px;
  background: var(--bg, #fff);
}
.wp-variants-inner {
  max-width: var(--max, 1280px);
  margin: 0 auto;
}

/* Two-column layout: image left | picker right */
.wp-variants-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
  align-items: center;
}

/* Color preview image column */
.wp-color-preview-wrap {
  position: relative;
  aspect-ratio: 3/4;
  border-radius: 6px;
  overflow: hidden;
  background: #f6f6f6;
}
.wp-color-preview {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.35s ease;
  pointer-events: none;
}
.wp-color-preview.active {
  opacity: 1;
  pointer-events: auto;
}
.wp-color-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.wp-color-preview .f-ph {
  border-radius: 0;
}

/* Picker column */
.wp-variants-picker {}

.wp-section-eyebrow {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted, #555550);
  margin-bottom: 24px;
}
.wp-color-label {
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.06em;
  margin-bottom: 12px;
  color: var(--text, #0d0d0d);
}
.wp-color-label span { color: var(--muted, #555550); font-weight: 400; }
.wp-swatches { display: flex; gap: 10px; margin-bottom: 32px; }
.wp-swatch {
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 2px solid transparent;
  outline: 2px solid transparent;
  outline-offset: 3px;
  cursor: pointer;
  transition: outline-color 0.15s, transform 0.15s;
}
.wp-swatch:hover { transform: scale(1.08); }
.wp-swatch.active { outline-color: var(--green, #245034); }
.wp-swatch[data-color="Green Rim"].active { outline-color: #0d0d0d; }
.wp-swatch[data-color="Pink Rim"]  { background: #e8a0b0; border-color: #ddd; }
.wp-swatch[data-color="Blue Rim"]  { background: #7bafd4; border-color: #ddd; }
.wp-swatch[data-color="Green Rim"] { background: #245034; }
.wp-mid-price { font-size: 28px; font-weight: 600; letter-spacing: -0.02em; margin-bottom: 16px; }
.wp-mid-note  { font-size: 12px; color: var(--muted, #555550); margin-top: 10px; letter-spacing: 0.03em; }

/* ── SPECS ─────────────────────────────────────────────── */
.wp-specs {
  padding: 64px 24px;
  background: var(--bg2, #f6f5f2);
}
.wp-specs-inner {
  max-width: var(--max, 1280px);
  margin: 0 auto;
}
.wp-specs-h {
  font-size: clamp(24px, 4vw, 36px);
  font-weight: 300;
  letter-spacing: -0.02em;
  margin-bottom: 40px;
}
.wp-specs-h em { font-weight: 600; font-style: normal; }
.wp-spec-grid { display: grid; grid-template-columns: 1fr; gap: 0; }
.wp-spec-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 16px 0;
  border-bottom: 1px solid #e0ddd8;
  gap: 16px;
}
.wp-spec-row:first-child { border-top: 1px solid #e0ddd8; }
.wp-spec-key {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted, #555550);
  flex-shrink: 0;
}
.wp-spec-val {
  font-size: 14px;
  font-weight: 500;
  color: var(--text, #0d0d0d);
  text-align: right;
}

/* ── BUILD QUALITY ─────────────────────────────────────── */
.wp-build {
  padding: 72px 24px;
  background: var(--bg, #fff);
}
.wp-build-inner {
  max-width: var(--max, 1280px);
  margin: 0 auto;
}
.wp-build-h {
  font-size: clamp(22px, 4vw, 34px);
  font-weight: 300;
  letter-spacing: -0.02em;
  margin-bottom: 40px;
  max-width: 480px;
}
.wp-build-h em { font-weight: 600; font-style: normal; }
.wp-build-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
}
.wp-build-item {
  padding: 24px 0;
  border-bottom: 1px solid #eee;
  display: grid;
  grid-template-columns: 28px 1fr;
  gap: 16px;
  align-items: start;
}
.wp-build-item:first-child { border-top: 1px solid #eee; }
.wp-build-icon { font-size: 18px; line-height: 1.4; flex-shrink: 0; }
.wp-build-copy {}
.wp-build-title { font-size: 14px; font-weight: 600; margin-bottom: 4px; letter-spacing: 0.02em; }
.wp-build-desc  { font-size: 13px; color: var(--muted, #555550); line-height: 1.55; font-weight: 400; }

/* ── LIFESTYLE FEATURE (full-bleed + text) ─────────────── */
.wp-feature {
  display: grid;
  grid-template-columns: 1fr;
  overflow: hidden;
}
.wp-feature-img { aspect-ratio: 4/3; }
.wp-feature-text {
  background: var(--green, #245034);
  color: #fff;
  padding: 48px 28px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16px;
}
.wp-feature-eyebrow {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  font-weight: 500;
}
.wp-feature-h {
  font-size: clamp(26px, 5vw, 44px);
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: -0.02em;
}
.wp-feature-h strong { font-weight: 600; }
.wp-feature-body {
  font-size: 14px;
  line-height: 1.65;
  color: rgba(255,255,255,0.78);
  font-weight: 400;
  max-width: 420px;
}

/* ── TRUST BAR ─────────────────────────────────────────── */
.wp-trust {
  padding: 40px 24px;
  background: var(--bg2, #f6f5f2);
  border-top: 1px solid #e8e6e1;
}
.wp-trust-inner {
  max-width: var(--max, 1280px);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px 16px;
}
.wp-trust-item { display: flex; flex-direction: column; gap: 4px; text-align: center; align-items: center; }
.wp-trust-label { font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--green, #245034); }
.wp-trust-val   { font-size: 13px; color: var(--muted, #555550); font-weight: 400; line-height: 1.4; }

/* ── FINAL CTA ─────────────────────────────────────────── */
.wp-final {
  background: var(--green, #245034);
  padding: 80px 24px;
  text-align: center;
  color: #fff;
}
.wp-final-h {
  font-size: clamp(28px, 6vw, 52px);
  font-weight: 300;
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin-bottom: 8px;
}
.wp-final-h strong { font-weight: 600; }
.wp-final-sub {
  font-size: 14px;
  color: rgba(255,255,255,0.65);
  font-weight: 400;
  margin-bottom: 36px;
}
.wp-final-price {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 20px;
  color: rgba(255,255,255,0.85);
}
.wp-btn-light {
  background: #fff;
  color: var(--green, #245034);
  border: none;
  border-radius: var(--radius, 4px);
  font-family: 'Neue Montreal', system-ui, sans-serif;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.08em;
  padding: 16px 40px;
  cursor: pointer;
  transition: background 0.2s, transform 0.15s;
  display: inline-block;
}
.wp-btn-light:hover { background: var(--mint, #e8f5ed); transform: translateY(-1px); }
.wp-btn-light:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
.wp-final-guarantee {
  margin-top: 16px;
  font-size: 11px;
  color: rgba(255,255,255,0.4);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* ── FEEDBACK TOAST ────────────────────────────────────── */
.wp-toast {
  position: fixed;
  bottom: 72px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: #0d0d0d;
  color: #fff;
  font-family: 'Neue Montreal', system-ui, sans-serif;
  font-size: 13px;
  font-weight: 500;
  padding: 12px 24px;
  border-radius: 40px;
  opacity: 0;
  transition: opacity 0.25s, transform 0.25s;
  pointer-events: none;
  z-index: 300;
  white-space: nowrap;
}
.wp-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ── DESKTOP OVERRIDES ─────────────────────────────────── */
@media (min-width: 768px) {
  .wp-hero-content { padding: 60px 60px 72px; }
  .wp-hero img { object-position: center; }
  .wp-statement { padding: 100px 60px; }
  .wp-lifestyle-grid {
    grid-template-columns: 1fr 1fr 1fr;
    gap: 4px;
  }
  .wp-ls-tall { aspect-ratio: 3/4; }
  .wp-ls-wide { aspect-ratio: 3/4; }
  .wp-ls-sq   { aspect-ratio: 3/4; }
  .wp-variants { padding: 48px 60px; }
  .wp-variants-inner { max-width: var(--max, 1280px); margin: 0 auto; }
  .wp-variants-layout {
    grid-template-columns: 0.6fr 1fr;
    gap: 60px;
    align-items: center;
    max-width: 820px;
    margin: 0 auto;
  }
  .wp-specs { padding: 100px 60px; }
  .wp-spec-grid { grid-template-columns: 1fr 1fr; column-gap: 60px; }
  .wp-build { padding: 100px 60px; }
  .wp-build-grid { grid-template-columns: 1fr 1fr; column-gap: 60px; }
  .wp-feature { grid-template-columns: 1fr 1fr; min-height: 560px; }
  .wp-feature-img { aspect-ratio: auto; }
  .wp-feature-text { padding: 64px 60px; }
  .wp-trust { padding: 48px 60px; }
  .wp-trust-inner { grid-template-columns: repeat(4, 1fr); }
  .wp-final { padding: 120px 60px; }
  .wp-sticky { padding: 16px 40px; }
}

/* ── MOBILE OVERRIDES ──────────────────────────────────── */
@media (max-width: 767px) {
  .wp-hero { height: 75vh; min-height: 460px; }
  .wp-hero img { object-position: center 15%; }
  .wp-color-preview-wrap { aspect-ratio: unset; height: 280px; max-width: 100%; background: #fff; }
  .wp-color-preview img { object-fit: contain; object-position: center; transform: scale(1.15); }
}
</style>

<!---------------------- STICKY CART BAR ------------------>
<div class="wp-sticky" id="wpSticky" role="region" aria-label="Quick purchase">
  <div class="wp-sticky-left">
    <div class="wp-sticky-name">{{ product.title }}</div>
    <div class="wp-sticky-price" id="wpStickyPrice">{{ current_variant.price | money }}</div>
  </div>
  <div class="wp-sticky-right">
    <div class="wp-sticky-swatches" id="wpStickySwatches">
      {%- for variant in product.variants -%}
        {%- assign color_name = variant.option1 -%}
        <button
          class="wp-swatch-mini{% if variant.id == current_variant.id %} active{% endif %}"
          data-variant-id="{{ variant.id }}"
          data-price="{{ variant.price | money }}"
          data-color="{{ color_name }}"
          aria-label="{{ color_name }} — {{ variant.price | money }}"
          title="{{ color_name }}">
        </button>
      {%- endfor -%}
    </div>
    <button class="wp-sticky-btn" id="wpStickyBtn" data-variant-id="{{ current_variant.id }}">
      Add to Cart
    </button>
  </div>
</div>

<!---------------------- TOAST -------------------------->
<div class="wp-toast" id="wpToast" aria-live="polite"></div>

<!---------------------- PAGE WRAPPER ------------------->
<div class="wp-page" id="wpHeroRef">

