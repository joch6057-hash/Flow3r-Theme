<!---------------------- JAVASCRIPT ----------------------->
<script>
(function() {
  'use strict';

  /* ── State ───────────────────────────────────────────── */
  var selectedVariantId = {{ current_variant.id }};
  var selectedPrice     = '{{ current_variant.price | money }}';
  var selectedColor     = '{{ current_variant.option1 }}';
  var isAdding          = false;

  /* ── Refs ────────────────────────────────────────────── */
  var sticky           = document.getElementById('wpSticky');
  var trigger          = document.getElementById('wpTrigger');
  var colorSection     = document.getElementById('wpColorSection');
  var stickyPrice      = document.getElementById('wpStickyPrice');
  var stickyBtn        = document.getElementById('wpStickyBtn');
  var heroBtn          = document.getElementById('wpHeroBtn');
  var midBtn           = document.getElementById('wpMidBtn');
  var finalBtn         = document.getElementById('wpFinalBtn');
  var heroPrice        = document.getElementById('wpHeroPrice');
  var midPrice         = document.getElementById('wpMidPrice');
  var finalPrice       = document.getElementById('wpFinalPrice');
  var colorName        = document.getElementById('wpColorName');
  var toast            = document.getElementById('wpToast');
  var swatches         = document.querySelectorAll('#wpSwatches .wp-swatch');
  var stickySwatchBtns = document.querySelectorAll('#wpStickySwatches .wp-swatch-mini');
  var heroSwatchBtns   = document.querySelectorAll('#wpHeroSwatches .wp-hero-swatch');
  var colorPreviews    = document.querySelectorAll('.wp-color-preview');

  /* ── Sticky bar visibility ───────────────────────────── */
  if (sticky && trigger) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          sticky.classList.add('visible');
        }
      });
    }, { threshold: 0.1 });
    io.observe(trigger);
  }

  /* ── Variant selection ───────────────────────────────── */
  function selectVariant(variantId, price, color) {
    selectedVariantId = variantId;
    selectedPrice     = price;
    selectedColor     = color;

    if (heroPrice)   heroPrice.textContent   = price;
    if (midPrice)    midPrice.textContent    = price;
    if (finalPrice)  finalPrice.textContent  = price;
    if (stickyPrice) stickyPrice.textContent = price;
    if (colorName)   colorName.textContent   = color;

    if (heroBtn) heroBtn.dataset.variantId = variantId;
    if (heroBtn) heroBtn.textContent = 'Add to Cart — ' + color;

    [midBtn, finalBtn, stickyBtn].forEach(function(btn) {
      if (btn) btn.dataset.variantId = variantId;
    });

    /* Sync main swatches */
    swatches.forEach(function(s) {
      var isActive = parseInt(s.dataset.variantId) === variantId;
      s.classList.toggle('active', isActive);
      s.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });

    /* Sync sticky swatches */
    stickySwatchBtns.forEach(function(s) {
      s.classList.toggle('active', parseInt(s.dataset.variantId) === variantId);
    });

    /* Sync hero swatches */
    heroSwatchBtns.forEach(function(s) {
      s.classList.toggle('active', parseInt(s.dataset.variantId) === variantId);
    });

    /* Swap color preview image */
    colorPreviews.forEach(function(el) {
      el.classList.toggle('active', el.dataset.variantPreview == variantId);
    });
  }

  /* ── Main swatch click ───────────────────────────────── */
  swatches.forEach(function(btn) {
    btn.addEventListener('click', function() {
      selectVariant(
        parseInt(this.dataset.variantId),
        this.dataset.price,
        this.dataset.color
      );
    });
  });

  /* ── Sticky swatch click ─────────────────────────────── */
  stickySwatchBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      selectVariant(
        parseInt(this.dataset.variantId),
        this.dataset.price,
        this.dataset.color
      );
    });
  });

  /* ── Hero swatch click: select + scroll to picker ───── */
  heroSwatchBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      selectVariant(
        parseInt(this.dataset.variantId),
        this.dataset.price,
        this.dataset.color
      );
      if (colorSection) {
        colorSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  /* ── Toast ───────────────────────────────────────────── */
  var toastTimer;
  function showToast(msg) {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function() { toast.classList.remove('show'); }, 2800);
  }

  /* ── Add to cart ─────────────────────────────────────── */
  function addToCart(btn) {
    if (isAdding) return;
    isAdding = true;

    var orig = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Adding…';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ id: selectedVariantId, quantity: 1 })
    })
    .then(function(r) {
      if (!r.ok) throw new Error('Cart error');
      return r.json();
    })
    .then(function() {
      btn.textContent = 'Added ✓';
      showToast(selectedColor + ' water pipe added to cart.');
      if (typeof Cart !== 'undefined' && Cart.open) Cart.open();
      setTimeout(function() { btn.textContent = orig; btn.disabled = false; isAdding = false; }, 1800);
    })
    .catch(function() {
      btn.textContent = 'Try again';
      showToast('Something went wrong. Please try again.');
      setTimeout(function() { btn.textContent = orig; btn.disabled = false; isAdding = false; }, 2000);
    });
  }

  /* ── Wire up all CTA buttons ─────────────────────────── */
  [heroBtn, midBtn, finalBtn, stickyBtn].forEach(function(btn) {
    if (btn) btn.addEventListener('click', function() { addToCart(this); });
  });

})();
</script>
