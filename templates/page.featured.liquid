{%- assign fp = pages['featured'] -%}
<div class="page-top">
  <nav class="breadcrumb"><a href="/">Home</a><span class="bc-sep">/</span><span class="bc-cur">Featured</span></nav>

  <div class="featured-hero">
    <div class="featured-img">
      {{- '' -}}
      {%- comment -%}
        TO REPLACE THIS IMAGE:
        Go to Admin → Online Store → Themes → Customize → navigate to Featured page
        → click the image area → upload your product photo
        OR edit this file and replace the SVG below with:
        <img src="{{ section.settings.featured_image | image_url: width: 900 }}" alt="Featured product">
      {%- endcomment -%}
      <svg width="210" height="370" viewBox="0 0 220 380" fill="none" aria-hidden="true">
        <ellipse cx="110" cy="238" rx="72" ry="90" fill="rgba(36,80,52,.28)" stroke="rgba(36,80,52,.28)" stroke-width="1.4"/>
        <ellipse cx="110" cy="238" rx="56" ry="70" fill="rgba(36,80,52,.12)"/>
        <rect x="93" y="40" width="34" height="118" rx="17" fill="rgba(36,80,52,.32)" stroke="rgba(36,80,52,.28)" stroke-width="1.4"/>
        <rect x="102" y="47" width="16" height="104" rx="8" fill="rgba(36,80,52,.12)"/>
        <rect x="91" y="136" width="38" height="6" fill="rgba(36,80,52,.5)"/>
        <rect x="93" y="36" width="34" height="8" rx="4" fill="rgba(36,80,52,.35)"/>
        <text x="110" y="92" fill="rgba(36,80,52,.45)" font-size="6" letter-spacing="3.5" text-anchor="middle" font-weight="700">FLOW3R</text>
        <path d="M48 266 Q33 230 48 188 Q60 165 83 163" stroke="rgba(36,80,52,.28)" stroke-width="9.5" fill="none" stroke-linecap="round"/>
        <path d="M172 266 Q187 230 172 188 Q160 165 137 163" stroke="rgba(36,80,52,.28)" stroke-width="9.5" fill="none" stroke-linecap="round"/>
        <line x1="138" y1="226" x2="172" y2="207" stroke="rgba(36,80,52,.45)" stroke-width="3" stroke-linecap="round"/>
        <ellipse cx="177" cy="204" rx="12" ry="8" fill="rgba(36,80,52,.38)" stroke="rgba(36,80,52,.28)" stroke-width="1"/>
        <ellipse cx="110" cy="326" rx="76" ry="15" fill="rgba(36,80,52,.2)" stroke="rgba(36,80,52,.18)" stroke-width="1.2"/>
      </svg>
    </div>
    <div class="featured-body">
      <div class="featured-badge">✦ This Month's Feature Drop</div>
      <h1 class="featured-title">The Obsidian<br>Recycler</h1>
      <p class="featured-desc">Our flagship closed-loop recycler. Forest green neck stripe, laser-etched FLOW3R mark, and a draw so smooth it'll ruin every other piece for you. Built from thick borosilicate with a sealed chamber system that eliminates splashback entirely.</p>
      <div class="featured-specs">
        <div class="featured-spec-box"><div class="featured-spec-label">System</div><div class="featured-spec-val">Closed-Loop Recycler</div></div>
        <div class="featured-spec-box"><div class="featured-spec-label">Joint</div><div class="featured-spec-val">14mm Female</div></div>
        <div class="featured-spec-box"><div class="featured-spec-label">Height</div><div class="featured-spec-val">11.5 inches</div></div>
        <div class="featured-spec-box"><div class="featured-spec-label">Bowl</div><div class="featured-spec-val">14mm Male</div></div>
      </div>
      <div class="featured-price-row">
        <div class="featured-price">$189</div>
        <div class="featured-ship">Free shipping · Ships in 3 days</div>
      </div>
      <div class="featured-actions">
        <a href="/collections/all" class="btn btn-dk">Shop Now</a>
        <a href="/collections/all" class="btn btn-ol">View Full Details</a>
      </div>
    </div>
  </div>

  <section class="featured-also">
    <h2 class="sec-h" style="font-size:28px;margin-bottom:26px">Also Featured This Month</h2>
    {%- assign also_col = collections['all'] -%}
    {%- if also_col.products.size > 0 -%}
      <div class="prod-grid">
        {%- for product in also_col.products limit: 4 -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="color:var(--g2);font-size:16px">Add products to your store to see them here.</p>
    {%- endif -%}
  </section>
</div>
