<script>
(function(){
  'use strict';
  var variantId    = {{ current_variant.id }};
  var isAdding     = false;
  var qty          = 1;
  var slideCount   = {{ product.images.size | default: 1 }};
  var currentSlide = 0;

  /* Sticky bar */
  var sticky = document.getElementById('acSticky');
  var layout = document.getElementById('acProductLayout');
  if (sticky && layout) {
    new IntersectionObserver(function(e){ sticky.classList.toggle('visible', !e[0].isIntersecting); }, { threshold: 0 }).observe(layout);
  }

  /* Qty */
  var qtyInput = document.getElementById('acQtyInput');
  document.getElementById('acQtyMinus').addEventListener('click', function(){ if(qty>1){qty--;qtyInput.value=qty;} });
  document.getElementById('acQtyPlus').addEventListener('click',  function(){ if(qty<10){qty++;qtyInput.value=qty;} });
  if(qtyInput) qtyInput.addEventListener('change', function(){ qty=Math.max(1,Math.min(10,parseInt(this.value)||1)); this.value=qty; });

  /* Toast */
  var toast=document.getElementById('acToast'), toastTimer;
  function showToast(msg){ if(!toast)return; toast.textContent=msg; toast.classList.add('show'); clearTimeout(toastTimer); toastTimer=setTimeout(function(){ toast.classList.remove('show'); },2800); }

  /* ATC */
  function addToCart(btn){
    if(isAdding)return; isAdding=true;
    var orig=btn.textContent; btn.disabled=true; btn.textContent='Adding…';
    fetch('/cart/add.js',{ method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, body:JSON.stringify({id:variantId,quantity:qty}) })
    .then(function(r){ if(!r.ok)throw new Error(); return r.json(); })
    .then(function(){ btn.textContent='Added ✓'; showToast('Added to cart.'); if(typeof Cart!=='undefined'&&Cart.open)Cart.open(); setTimeout(function(){ btn.textContent=orig; btn.disabled=false; isAdding=false; },1800); })
    .catch(function(){ btn.textContent='Try again'; showToast('Something went wrong.'); setTimeout(function(){ btn.textContent=orig; btn.disabled=false; isAdding=false; },2000); });
  }
  var atcBtn=document.getElementById('acAtcBtn'), stickyBtn=document.getElementById('acStickyBtn');
  if(atcBtn) atcBtn.addEventListener('click', function(){ addToCart(this); });
  if(stickyBtn) stickyBtn.addEventListener('click', function(){ addToCart(this); });

  /* Carousel */
  if(slideCount>1){
    var track=document.getElementById('acTrack'), dots=document.querySelectorAll('.ac-dot'), prev=document.getElementById('acPrev'), next=document.getElementById('acNext'), thumbs=document.querySelectorAll('.ac-thumb');
    function goTo(n){ currentSlide=Math.max(0,Math.min(slideCount-1,n)); if(track)track.style.transform='translateX(-'+(currentSlide*100)+'%)'; dots.forEach(function(d,i){ d.classList.toggle('active',i===currentSlide); }); thumbs.forEach(function(t,i){ t.classList.toggle('active',i===currentSlide); }); if(thumbs[currentSlide]){ thumbs[currentSlide].scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'}); } }
    dots.forEach(function(d){ d.addEventListener('click',function(){ goTo(parseInt(this.dataset.index)); }); });
    thumbs.forEach(function(t){ t.addEventListener('click',function(){ goTo(parseInt(this.dataset.index)); }); });
    if(prev) prev.addEventListener('click',function(){ goTo(currentSlide-1); });
    if(next) next.addEventListener('click',function(){ goTo(currentSlide+1); });
    if(track){
      var startX=0;
      track.addEventListener('touchstart',function(e){ startX=e.touches[0].clientX; },{passive:true});
      track.addEventListener('touchend',function(e){ var dx=e.changedTouches[0].clientX-startX; if(Math.abs(dx)>40)goTo(dx<0?currentSlide+1:currentSlide-1); },{passive:true});
    }
  }

  /* FAQ accordion */
  document.querySelectorAll('.ac-faq-q').forEach(function(btn){
    btn.addEventListener('click',function(){
      var ans=this.nextElementSibling, icon=this.querySelector('.ac-faq-icon'), isOpen=ans.classList.contains('open');
      document.querySelectorAll('.ac-faq-a').forEach(function(a){ a.classList.remove('open'); a.setAttribute('aria-hidden','true'); });
      document.querySelectorAll('.ac-faq-q').forEach(function(q){ q.setAttribute('aria-expanded','false'); });
      document.querySelectorAll('.ac-faq-icon').forEach(function(i){ i.classList.remove('open'); });
      if(!isOpen){ ans.classList.add('open'); ans.setAttribute('aria-hidden','false'); this.setAttribute('aria-expanded','true'); if(icon)icon.classList.add('open'); }
    });
  });

  /* Return policy toggle */
  var rt=document.getElementById('acReturnToggle'), rb=document.getElementById('acReturnBody'), ri=document.getElementById('acReturnIcon');
  if(rt){ rt.addEventListener('click',function(){ var o=rb.classList.toggle('open'); ri.classList.toggle('open',o); this.setAttribute('aria-expanded',o?'true':'false'); rb.setAttribute('aria-hidden',o?'false':'true'); }); }

  /* Contact form */
  var cf=document.getElementById('acContactForm'), cs=document.getElementById('acFormSuccess');
  if(cf){ cf.addEventListener('submit',function(e){
    e.preventDefault();
    var sb=this.querySelector('.ac-form-btn'), orig=sb.textContent; sb.disabled=true; sb.textContent='Sending…';
    fetch('/contact',{ method:'POST', body:new FormData(this), headers:{'X-Requested-With':'XMLHttpRequest'} })
    .then(function(){ if(cs)cs.classList.add('show'); cf.reset(); sb.textContent=orig; sb.disabled=false; })
    .catch(function(){ sb.textContent='Try again'; setTimeout(function(){ sb.textContent=orig; sb.disabled=false; },2500); });
  }); }

})();
</script>
