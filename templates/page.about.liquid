{%- comment -%}
  templates/page.about.liquid — v2 (matches Shop Editorial v4)
  Thin Neue Montreal display, green bookends, no emoji, no dot separators.
  All original copy preserved. FAQ shipping + rewards answers corrected to
  match the live FAQ page and rebuilt rewards page (killed contradictions).
{%- endcomment -%}

<div class="abx page-top">

  <style>
    .abx{font-family:'Neue Montreal',system-ui,-apple-system,sans-serif;color:#0d0d0d;background:#fff;
      --green:#245034;--green-h:#1a3d26;--muted:#6b6b66;--line:#e6e6e3;}
    .abx *,.abx *::before,.abx *::after{box-sizing:border-box;}
    .abx-eyebrow{font-size:11px;font-weight:500;letter-spacing:.22em;text-transform:uppercase;}

    .abx-hero{background:var(--green);padding:64px 24px 56px;}
    .abx-hero-in{max-width:1180px;margin:0 auto;}
    .abx-hero .abx-eyebrow{color:rgba(232,245,237,.6);margin-bottom:18px;display:block;}
    .abx-hero-h{font-size:clamp(40px,8vw,76px);font-weight:300;letter-spacing:-.03em;line-height:1;color:#fff;margin:0;}
    .abx-hero-sub{margin-top:22px;font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.6);}

    .abx-story{max-width:1180px;margin:0 auto;padding:64px 24px;display:grid;grid-template-columns:1fr;gap:44px;border-bottom:1px solid var(--line);}
    .abx-story-num{font-size:12px;font-weight:500;letter-spacing:.1em;color:var(--green);margin-bottom:14px;}
    .abx-story-h{font-size:22px;font-weight:500;letter-spacing:-.01em;margin:0 0 12px;}
    .abx-story-p{font-size:16px;line-height:1.7;color:var(--muted);margin:0;}

    .abx-stats{max-width:1180px;margin:0 auto;padding:56px 24px;display:grid;grid-template-columns:1fr 1fr;gap:40px 16px;border-bottom:1px solid var(--line);}
    .abx-stat{text-align:center;}
    .abx-stat-num{font-size:clamp(34px,5vw,46px);font-weight:300;letter-spacing:-.02em;color:var(--green);line-height:1;}
    .abx-stat-label{margin-top:12px;font-size:10px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);}

    .abx-cat{background:var(--green);padding:72px 24px;text-align:center;}
    .abx-cat-in{max-width:560px;margin:0 auto;}
    .abx-cat .abx-eyebrow{color:rgba(232,245,237,.55);margin-bottom:14px;display:block;}
    .abx-cat-h{font-size:clamp(26px,4vw,40px);font-weight:300;letter-spacing:-.025em;color:#fff;line-height:1.1;margin:0 0 16px;}
    .abx-cat-p{font-size:15px;line-height:1.65;color:rgba(255,255,255,.62);margin:0 0 28px;}
    .abx-btn{display:inline-block;background:#fff;color:var(--green);text-decoration:none;border-radius:4px;font-size:13px;font-weight:500;letter-spacing:.05em;padding:14px 28px;transition:opacity .2s;}
    .abx-btn:hover{opacity:.9;}

    .abx-faq{max-width:820px;margin:0 auto;padding:72px 24px 0;}
    .abx-faq-head{margin-bottom:36px;}
    .abx-faq .abx-eyebrow{color:var(--green);margin-bottom:14px;display:block;}
    .abx-faq-h{font-size:clamp(28px,5vw,44px);font-weight:300;letter-spacing:-.03em;line-height:1;margin:0 0 12px;}
    .abx-faq-sub{font-size:15px;color:var(--muted);line-height:1.6;margin:0;}
    .abx-contact-wrap{max-width:820px;margin:0 auto;padding:0 24px 80px;}

    .ab-contact{margin-top:44px;background:#fff;border:1.5px solid rgba(0,0,0,.1);border-radius:6px;padding:34px 38px;scroll-margin-top:120px}
    .ab-contact-head{margin-bottom:24px}
    .ab-contact-h{font-size:21px;font-weight:500;color:#0d0d0d;margin-bottom:6px;letter-spacing:-.01em}
    .ab-contact-p{font-size:15px;color:#555550;line-height:1.6}
    .ab-form{display:flex;flex-direction:column;gap:15px}
    .ab-form-row{display:grid;grid-template-columns:1fr;gap:15px}
    .ab-field{display:flex;flex-direction:column;gap:7px}
    .ab-field label{font-size:11px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:#555550}
    .ab-opt{color:#aaa;font-weight:500;letter-spacing:0;text-transform:none}
    .ab-field input,.ab-field textarea{font-family:'Neue Montreal',system-ui,sans-serif;font-size:14px;color:#0d0d0d;background:#fff;border:1.5px solid rgba(0,0,0,.16);border-radius:4px;padding:12px 14px;width:100%;transition:border-color .15s}
    .ab-field input::placeholder,.ab-field textarea::placeholder{color:#b3b3b0}
    .ab-field input:focus,.ab-field textarea:focus{outline:none;border-color:#245034}
    .ab-field textarea{resize:vertical;min-height:130px;line-height:1.6}
    .ab-form-btn{align-self:flex-start;background:#245034;color:#fff;border:none;border-radius:4px;font-family:'Neue Montreal',system-ui,sans-serif;font-size:14px;font-weight:500;letter-spacing:.05em;padding:14px 30px;cursor:pointer;transition:background .2s,transform .15s}
    .ab-form-btn:hover{background:#1a3d26;transform:translateY(-1px)}
    .ab-form-success{border:1.5px solid rgba(36,80,52,.3);background:#e8f5ed;border-radius:6px;padding:24px 22px}
    .ab-form-success-h{font-size:17px;font-weight:500;color:#245034;margin-bottom:7px}
    .ab-form-success-p{font-size:14px;color:#3c5a44;line-height:1.6}
    .ab-form-errors{background:#fcebea;border:1px solid rgba(190,60,55,.32);border-radius:4px;padding:13px 16px;margin-bottom:15px}
    .ab-form-errors ul{margin:0;padding-left:18px}
    .ab-form-errors li{font-size:13px;color:#b23b3b;line-height:1.5}

    @media(min-width:600px){.ab-form-row{grid-template-columns:1fr 1fr}}
    @media(min-width:900px){
      .abx-hero{padding:96px 60px 80px;}
      .abx-story{grid-template-columns:repeat(3,1fr);gap:60px;padding:96px 60px;}
      .abx-stats{grid-template-columns:repeat(4,1fr);padding:72px 60px;}
      .abx-stat + .abx-stat{border-left:1px solid var(--line);}
      .abx-cat{padding:104px 60px;}
      .abx-faq{padding:96px 60px 0;}
      .abx-contact-wrap{padding:0 60px 112px;}
    }
    @media(max-width:768px){.ab-contact{padding:24px 22px;scroll-margin-top:96px}}
  </style>

  <nav class="breadcrumb"><a href="/">Home</a><span class="bc-sep">/</span><span class="bc-cur">About</span></nav>

  <section class="abx-hero">
    <div class="abx-hero-in">
      <span class="abx-eyebrow">Our Story</span>
      <h1 class="abx-hero-h">Not a headshop.<br>A standard.</h1>
      <p class="abx-hero-sub">California-built · Daily-tested · No compromises</p>
    </div>
  </section>

  <section class="abx-story">
    <div class="abx-story-col">
      <div class="abx-story-num">01</div>
      <h2 class="abx-story-h">The Problem</h2>
      <p class="abx-story-p">Cheap imports break in two sessions. Artist pieces cost more than rent. Nothing in the middle was designed with intention — just sourced, boxed, and shipped.</p>
    </div>
    <div class="abx-story-col">
      <div class="abx-story-num">02</div>
      <h2 class="abx-story-h">The Standard</h2>
      <p class="abx-story-p">Every piece we carry is hand-selected and tested. Thick borosilicate only. We spec joint sizes ourselves. If it doesn't earn a spot on our counter, it doesn't make the catalog.</p>
    </div>
    <div class="abx-story-col">
      <div class="abx-story-num">03</div>
      <h2 class="abx-story-h">The Commitment</h2>
      <p class="abx-story-p">Small operation. Real people. We ship from California, stand behind every order with a 1-year guarantee, and donate a portion of every Cat Collection sale to local California cat rescue.</p>
    </div>
  </section>

  <section class="abx-stats">
    <div class="abx-stat">
      <div class="abx-stat-num">100%</div>
      <div class="abx-stat-label">Borosilicate Glass</div>
    </div>
    <div class="abx-stat">
      <div class="abx-stat-num">CA</div>
      <div class="abx-stat-label">Based &amp; Operated</div>
    </div>
    <div class="abx-stat">
      <div class="abx-stat-num">1-Year</div>
      <div class="abx-stat-label">Guarantee</div>
    </div>
    <div class="abx-stat">
      <div class="abx-stat-num">Cat Fam</div>
      <div class="abx-stat-label">Supports CA Rescue</div>
    </div>
  </section>

  <section class="abx-cat">
    <div class="abx-cat-in">
      <span class="abx-eyebrow">The Cat Fam Initiative</span>
      <h2 class="abx-cat-h">A portion of every Cat Collection sale goes to California cat rescue.</h2>
      <p class="abx-cat-p">We love cats. Real impact, every order — no fine print, no spare-change gimmick.</p>
      <a href="/pages/cat-fam" class="abx-btn">Visit the Cat Fam Page</a>
    </div>
  </section>

  <section class="abx-faq">
    <div class="abx-faq-head">
      <span class="abx-eyebrow">Support</span>
      <h2 class="abx-faq-h">FAQ &amp; Support</h2>
      <p class="abx-faq-sub">Everything about ordering, shipping, returns, and warranties.</p>
    </div>

    <div class="faq-accordion">

      <div class="faq-group-label">Shipping</div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false"><span>How long does shipping take?</span><span class="faq-icon">+</span></button>
        <div class="faq-answer"><div class="faq-answer-inner">Orders process in 1&ndash;3 business days, then ship from California — about 7 business days to arrive. We'll always try to get it to you sooner.</div></div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false"><span>Is packaging discreet?</span><span class="faq-icon">+</span></button>
        <div class="faq-answer"><div class="faq-answer-inner">Always. Every order ships in a plain outer box with <strong>no logos, no product descriptions, and no indication of contents</strong> — inside or out.</div></div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false"><span>Do you ship internationally?</span><span class="faq-icon">+</span></button>
        <div class="faq-answer"><div class="faq-answer-inner">Currently we ship to all 50 US states. International shipping is not available at this time.</div></div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false"><span>How much is shipping?</span><span class="faq-icon">+</span></button>
        <div class="faq-answer"><div class="faq-answer-inner"><strong>Free shipping on all orders over $75.</strong> Standard shipping on orders under $75 is calculated at checkout based on your location.</div></div>
      </div>

      <div id="warranty" class="faq-group-label" style="margin-top:32px">Returns &amp; Warranty</div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false"><span>What's your return policy?</span><span class="faq-icon">+</span></button>
        <div class="faq-answer"><div class="faq-answer-inner">Returns accepted on <strong>unopened, unused items within 14 days of delivery.</strong> We can't accept used pieces for hygiene reasons. Return shipping is the customer's responsibility unless the item arrived damaged. Contact us with your order number to start a return.</div></div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false"><span>What does the 1-Year Guarantee cover?</span><span class="faq-icon">+</span></button>
        <div class="faq-answer"><div class="faq-answer-inner">Manufacturing defects, joint failures, and stress cracks under normal use. Doesn't cover drops. Email us with your order number and photos — <strong>we'll take care of you.</strong></div></div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false"><span>My item arrived damaged. What now?</span><span class="faq-icon">+</span></button>
        <div class="faq-answer"><div class="faq-answer-inner">Don't dispose of packaging. Photograph the box and the piece. Email us within 48 hours — <strong>we'll ship a replacement at no cost.</strong></div></div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false"><span>Can I exchange for a different product?</span><span class="faq-icon">+</span></button>
        <div class="faq-answer"><div class="faq-answer-inner">Yes, for unopened items in the return window. Reach out before returning so we can confirm availability and provide a return label.</div></div>
      </div>

      <div class="faq-group-label" style="margin-top:32px">Products &amp; Ordering</div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false"><span>What is borosilicate glass?</span><span class="faq-icon">+</span></button>
        <div class="faq-answer"><div class="faq-answer-inner">Laboratory-grade glass known for thermal resistance and durability. <strong>Significantly stronger than regular glass</strong> and handles temperature changes without cracking. Chemically inert — it doesn't react with heat or leach chemicals. Every piece we carry uses it.</div></div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false"><span>Are your products for tobacco use only?</span><span class="faq-icon">+</span></button>
        <div class="faq-answer"><div class="faq-answer-inner">All FLOW3R products are sold as <strong>tobacco smoking accessories</strong> for legal use in accordance with your local and state laws. By purchasing, you confirm you are 21+.</div></div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false"><span>How do I clean my piece?</span><span class="faq-icon">+</span></button>
        <div class="faq-answer"><div class="faq-answer-inner">Rinse with warm water after every session. For a deep clean, use 91%+ isopropyl alcohol and coarse salt — shake, soak, rinse. Check our <a href="/pages/glass-guide" style="color:#245034;font-weight:500">Glass Guide</a> for full step-by-step instructions.</div></div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false"><span>Do you have a rewards program?</span><span class="faq-icon">+</span></button>
        <div class="faq-answer"><div class="faq-answer-inner">Yes. Earn 5 points for every $1 spent, and redeem 100 points for $1 off. Join free — no tiers, no catch. <a href="/pages/rewards" style="color:#245034;font-weight:500">Learn more about rewards &rarr;</a></div></div>
      </div>

    </div>
  </section>

  <div class="abx-contact-wrap">
    <section class="ab-contact" id="ab-contact">
      <div class="ab-contact-head">
        <h3 class="ab-contact-h">Still have a question?</h3>
        <p class="ab-contact-p">Our team is California-based and answers every message personally — usually within 24 hours. No bots.</p>
      </div>
      {%- form 'contact', id: 'aboutContactForm' -%}
        {%- if form.posted_successfully? -%}
          <div class="ab-form-success" id="abContactSuccess">
            <div class="ab-form-success-h">Message sent.</div>
            <p class="ab-form-success-p">Thanks — we'll get back to you within 24 hours, usually sooner. Check your inbox.</p>
          </div>
          <script>
            document.addEventListener('DOMContentLoaded',function(){
              var s=document.getElementById('abContactSuccess');
              if(s){s.scrollIntoView({behavior:'smooth',block:'center'});}
            });
          </script>
        {%- else -%}
          {%- if form.errors -%}
            <div class="ab-form-errors">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <input type="hidden" name="contact[subject]" value="Contact form — About page">
          <div class="ab-form">
            <div class="ab-form-row">
              <div class="ab-field">
                <label for="abName">Name</label>
                <input type="text" id="abName" name="contact[name]" autocomplete="name" required>
              </div>
              <div class="ab-field">
                <label for="abEmail">Email</label>
                <input type="email" id="abEmail" name="contact[email]" autocomplete="email" required>
              </div>
            </div>
            <div class="ab-field">
              <label for="abOrder">Order number <span class="ab-opt">&mdash; optional</span></label>
              <input type="text" id="abOrder" name="contact[Order number]" placeholder="#1234">
            </div>
            <div class="ab-field">
              <label for="abBody">Message</label>
              <textarea id="abBody" name="contact[body]" placeholder="What can we help with?" required></textarea>
            </div>
            <button type="submit" class="ab-form-btn">Send Message</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </section>
  </div>

</div>