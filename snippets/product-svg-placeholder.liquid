{%- comment -%}
  Shows a branded SVG illustration when a product has no photo.
  Usage: {% render 'product-svg-placeholder', product_type: product.type %}
{%- endcomment -%}

{%- assign t = product_type | downcase -%}
{%- assign fill = "rgba(36,80,52,.35)" -%}
{%- assign stroke = "rgba(36,80,52,.28)" -%}

{%- if t contains 'cat' or t contains 'purr' or t contains 'meow' -%}
  {%- assign fill = "rgba(183,107,168,.38)" -%}
  {%- assign stroke = "rgba(183,107,168,.28)" -%}
{%- endif -%}

{%- if t contains 'beaker' or t contains 'bong' or t contains 'water' -%}
  <svg width="78" height="138" viewBox="0 0 78 140" fill="none" aria-hidden="true">
    <rect x="30" y="6" width="18" height="66" rx="9" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <path d="M11 84 Q9 116 4 122 L4 125 Q4 127 6 127 L72 127 Q74 127 74 125 L74 122 Q69 116 67 84Z" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <rect x="28" y="3" width="22" height="7" rx="3.5" fill="{{ fill }}"/>
    <rect x="28" y="72" width="22" height="4" rx="2" fill="{{ stroke }}"/>
    <text x="39" y="112" fill="{{ fill }}" font-size="4" letter-spacing="2" text-anchor="middle" font-weight="700">FLOW3R</text>
  </svg>
{%- elsif t contains 'straight' or t contains 'tube' -%}
  <svg width="38" height="138" viewBox="0 0 38 140" fill="none" aria-hidden="true">
    <rect x="12" y="4" width="14" height="118" rx="7" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <ellipse cx="19" cy="126" rx="14" ry="8" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <rect x="12" y="1" width="14" height="6" rx="3" fill="{{ fill }}"/>
  </svg>
{%- elsif t contains 'recycler' -%}
  <svg width="100" height="138" viewBox="0 0 100 140" fill="none" aria-hidden="true">
    <ellipse cx="50" cy="96" rx="40" ry="36" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <rect x="38" y="14" width="24" height="60" rx="12" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <path d="M16 106 Q4 84 16 62 Q25 46 36 45" stroke="{{ fill }}" stroke-width="9" fill="none" stroke-linecap="round"/>
    <path d="M84 106 Q96 84 84 62 Q75 46 64 45" stroke="{{ fill }}" stroke-width="9" fill="none" stroke-linecap="round"/>
    <rect x="38" y="10" width="24" height="7" rx="3.5" fill="{{ fill }}"/>
  </svg>
{%- elsif t contains 'dab' or t contains 'rig' -%}
  <svg width="88" height="120" viewBox="0 0 88 120" fill="none" aria-hidden="true">
    <ellipse cx="44" cy="80" rx="30" ry="30" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <rect x="35" y="16" width="18" height="50" rx="9" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <line x1="62" y1="70" x2="78" y2="56" stroke="{{ stroke }}" stroke-width="2.5" stroke-linecap="round"/>
    <ellipse cx="81" cy="53" rx="8" ry="6" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="0.8"/>
    <rect x="35" y="13" width="18" height="5" rx="2.5" fill="{{ fill }}"/>
  </svg>
{%- elsif t contains 'nectar' -%}
  <svg width="30" height="120" viewBox="0 0 30 120" fill="none" aria-hidden="true">
    <rect x="8" y="4" width="14" height="96" rx="7" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <ellipse cx="15" cy="104" rx="12" ry="6" fill="{{ fill }}"/>
    <rect x="8" y="1" width="14" height="6" rx="3" fill="{{ fill }}"/>
  </svg>
{%- elsif t contains 'bubbler' -%}
  <svg width="88" height="96" viewBox="0 0 90 100" fill="none" aria-hidden="true">
    <ellipse cx="45" cy="66" rx="34" ry="28" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <rect x="35" y="8" width="20" height="44" rx="10" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <rect x="35" y="5" width="20" height="7" rx="3.5" fill="{{ fill }}"/>
  </svg>
{%- elsif t contains 'grinder' -%}
  <svg width="78" height="78" viewBox="0 0 80 80" fill="none" aria-hidden="true">
    <circle cx="40" cy="40" r="30" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1.2"/>
    <circle cx="40" cy="40" r="22" fill="{{ fill }}" opacity=".5"/>
    <circle cx="40" cy="40" r="12" fill="{{ fill }}"/>
    <line x1="40" y1="8" x2="40" y2="15" stroke="{{ stroke }}" stroke-width="2" stroke-linecap="round"/>
    <line x1="40" y1="65" x2="40" y2="72" stroke="{{ stroke }}" stroke-width="2" stroke-linecap="round"/>
    <line x1="8" y1="40" x2="15" y2="40" stroke="{{ stroke }}" stroke-width="2" stroke-linecap="round"/>
    <line x1="65" y1="40" x2="72" y2="40" stroke="{{ stroke }}" stroke-width="2" stroke-linecap="round"/>
  </svg>
{%- elsif t contains 'paper' or t contains 'cone' -%}
  <svg width="78" height="100" viewBox="0 0 78 100" fill="none" aria-hidden="true">
    <rect x="12" y="12" width="54" height="70" rx="6" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <rect x="12" y="8" width="54" height="8" rx="3" fill="{{ stroke }}"/>
    <line x1="20" y1="28" x2="58" y2="28" stroke="{{ stroke }}" stroke-width="1.2"/>
    <line x1="20" y1="38" x2="58" y2="38" stroke="{{ stroke }}" stroke-width="1.2" opacity=".6"/>
    <line x1="20" y1="48" x2="58" y2="48" stroke="{{ stroke }}" stroke-width="1.2" opacity=".6"/>
  </svg>
{%- elsif t contains 'bundle' -%}
  <svg width="96" height="96" viewBox="0 0 100 100" fill="none" aria-hidden="true">
    <rect x="5" y="35" width="22" height="56" rx="4" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <rect x="34" y="22" width="22" height="70" rx="4" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <rect x="63" y="30" width="22" height="62" rx="4" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1"/>
    <rect x="3" y="88" width="94" height="4" rx="2" fill="{{ stroke }}" opacity=".5"/>
  </svg>
{%- elsif t contains 'tray' -%}
  <svg width="92" height="78" viewBox="0 0 96 80" fill="none" aria-hidden="true">
    <rect x="4" y="16" width="88" height="52" rx="8" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1.2"/>
    <rect x="10" y="22" width="76" height="40" rx="5" fill="{{ fill }}" opacity=".5"/>
    <text x="48" y="46" fill="{{ stroke }}" font-size="5" letter-spacing="2" text-anchor="middle" font-weight="700">FLOW3R</text>
  </svg>
{%- else -%}
  <svg width="70" height="96" viewBox="0 0 70 96" fill="none" aria-hidden="true">
    <rect x="18" y="8" width="34" height="72" rx="9" fill="{{ fill }}"/>
    <text x="35" y="52" fill="{{ stroke }}" font-size="5" letter-spacing="1.5" text-anchor="middle" font-weight="700">FLOW3R</text>
  </svg>
{%- endif -%}
