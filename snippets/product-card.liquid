{%- comment -%}
  snippets/product-card.liquid
  Renders a product card.
  Usage: {% render 'product-card', product: product %}

  v3 changes (no visual change intended):
  - FIX: "Add to Cart" button moved OUT of the <a> wrapper. A <button>
    inside an <a> is invalid HTML. The image link and the quick-add
    button are now siblings inside .prod-img-wrap (a <div>).
  - FIX: hover effects (image swap / lift / zoom) disabled on touch
    devices via @media (hover: none) — that hover state was eating the
    first tap on mobile ("tap twice" bug). Desktop hover is unchanged.
{%- endcomment -%}

<style>
  /* Touch devices only: kill hover-only effects so one tap navigates
     instead of just triggering a hover state. Desktop is untouched. */
  @media (hover: none) {
    .prod-card:hover { transform: none !important; box-shadow: none !important; border-color: var(--bd) !important; }
    .prod-card:hover .prod-img-primary { opacity: 1 !important; }
    .prod-card:hover .prod-img-secondary { opacity: 0 !important; }
    .prod-card:hover .prod-img-wrap img { transform: none !important; }
  }
  /* Full-size click layer for the image link (button is now its sibling) */
  .prod-img-link { position: absolute; inset: 0; display: block; z-index: 1; }
  .prod-img-link .prod-img-placeholder { width: 100%; height: 100%; }
</style>

{%- assign first_image  = product.featured_image -%}
{%- assign second_image = product.images[1] -%}

<article class="prod-card" data-product-id="{{ product.id }}">
  <div class="prod-img-wrap">
    <a href="{{ product.url }}"
       class="prod-img-link"
       aria-label="{{ product.title | escape }}">

      {%- if first_image != blank -%}
        <img class="prod-img-primary"
             src="{{ first_image | image_url: width: 600 }}"
             alt="{{ first_image.alt | default: product.title | escape }}"
             width="600" height="600" loading="lazy">
        {%- if second_image != blank -%}
          <img class="prod-img-secondary"
               src="{{ second_image | image_url: width: 600 }}"
               alt="{{ second_image.alt | default: product.title | escape }}"
               width="600" height="600" loading="lazy">
        {%- endif -%}
      {%- else -%}
        <div class="prod-img-placeholder">
          {%- render 'product-svg-placeholder', product_type: product.type -%}
        </div>
      {%- endif -%}
    </a>

    {%- if product.tags contains 'best-seller' -%}
      <div class="prod-badge">Best Seller</div>
    {%- elsif product.tags contains 'new' -%}
      <div class="prod-badge">New</div>
    {%- endif -%}

    <div class="prod-quick-add">
      <button class="prod-quick-add-btn"
              type="button"
              onclick="Cart.addItem({{ product.variants.first.id }}, 1)"
              aria-label="Add {{ product.title | escape }} to cart">
        Add to Cart
      </button>
    </div>
  </div>

  <div class="prod-info">
    <div class="prod-type">{{ product.type }}</div>
    <h3 class="prod-title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <div class="prod-bottom">
      <div class="prod-price">
        {%- if product.compare_at_price > product.price -%}
          <span style="text-decoration:line-through;color:var(--g3);font-size:14px;font-weight:400;margin-right:6px">
            {{ product.compare_at_price | money }}
          </span>
        {%- endif -%}
        {{ product.price | money }}
      </div>
      <button class="prod-add-btn"
              type="button"
              onclick="Cart.addItem({{ product.variants.first.id }}, 1)"
              aria-label="Add {{ product.title | escape }} to cart">+</button>
    </div>
  </div>
</article>