        <div class="bdg" id="cart-badge">0</div>
      </button>
      <a href="/pages/shop" class="nav-cta">Shop Now</a>
    </div>
  </header>
  <!-- ═══ MOBILE DRAWER ═══ -->
  <nav id="mob-drawer" aria-label="Mobile navigation">
    <a href="/pages/shop" class="mob-nav-link" onclick="closeMobileNav()">Shop</a>
    <a href="/blogs/the-learning-hub" class="mob-nav-link" onclick="closeMobileNav()">Learn</a>
