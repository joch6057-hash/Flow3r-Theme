    <div class="mob-drawer-cta">
      <a href="/pages/shop" onclick="closeMobileNav()">Shop Now →</a>
    </div>
  </nav>

  <!-- ═══ SEARCH OVERLAY ═══ -->
  <div id="search-overlay" class="search-overlay" role="dialog" aria-modal="true" aria-label="Search">
    <div class="search-box">
      <form action="/search" method="get" class="search-form">
        <input type="hidden" name="type" value="product">
        <input class="search-input" type="search" name="q" id="search-input" placeholder="Search products…" autocomplete="off" aria-label="Search">
        <button type="button" class="search-close" onclick="closeSearch()" aria-label="Close search">✕</button>
      </form>
      <div class="search-hint">Try "water pipe", "grinder", "cat collection"…</div>
    </div>
  </div>

  <!-- ═══ CART DRAWER ═══ -->
  <div id="cart-overlay" class="cart-overlay" onclick="closeCart()" aria-hidden="true"></div>
  <div id="cart-panel" class="cart-panel" role="dialog" aria-modal="true" aria-label="Shopping cart">
    <div class="cart-head">
      <h3>Your Cart <span id="cart-count-label" style="color:#999;font-weight:400;font-size:15px">(0)</span></h3>
      <button class="cart-close" onclick="closeCart()" aria-label="Close cart">✕</button>
    </div>
    <div class="cart-body" id="cart-items-list">
      <div class="cart-empty">
        <p>Your cart is empty.</p>
        <a href="/pages/shop" class="btn btn-dk" onclick="closeCart()">Continue Shopping</a>
      </div>
    </div>
    <div class="cart-foot" id="cart-footer" style="display:none">
      <div class="cart-subtotal-row">
        <span class="cart-subtotal-label">Subtotal</span>
        <span class="cart-subtotal-val" id="cart-total">$0</span>
      </div>
      <a href="/cart" class="cart-checkout-btn">View Cart →</a>
