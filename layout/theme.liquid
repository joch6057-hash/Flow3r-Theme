<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="theme-color" content="#245034">

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- else -%}
    <meta name="description" content="Premium functional glass. Water pipes, cat-themed pieces, and accessories — California-based, 1-year guarantee, discreet plain packaging.">
  {%- endif -%}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title }} — {{ shop.name }}">
  <meta property="og:type" content="website">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
  {%- endif -%}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title }}">
  {%- if page_description -%}
    <meta name="twitter:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta name="twitter:image" content="{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}

  <title>{{ page_title }}{%- unless page_title contains shop.name %} — {{ shop.name }}{%- endunless -%}</title>

<link rel="icon" type="image/png" href="{{ 'flaviconfinal.png' | asset_url }}">

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://api.fontshare.com/v2/css?f[]=neue-montreal@300,400,500,600,700&display=swap" rel="stylesheet">
  {{ 'flow3r.css' | asset_url | stylesheet_tag }}
  {{ 'flow3r-nav.css' | asset_url | stylesheet_tag }}
  {{ 'flow3r-clean.css' | asset_url | stylesheet_tag }}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ shop.name | escape }}",
    "url": "{{ shop.url }}",
    "description": "Premium functional glass for adults who want cleaner, smoother sessions. California-based.",
    "logo": "{{ 'flaviconfinal.png' | asset_url }}",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@flow3r.shop",
      "contactType": "customer service"
    },
    "sameAs": [
      "https://instagram.com/flow3r.glass",
      "https://tiktok.com/@flow3r.shop"
    ],
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "CA",
      "addressCountry": "US"
    }
  }
  </script>
</head>

<body class="lock">

  <!-- ═══ AGE GATE ═══ -->
  {%- if settings.age_gate_enabled -%}
  <div id="age-gate" class="age-gate" style="display:none">
    <div class="age-gate-inner">
      <div class="age-gate-logo">
        <img src="{{ 'flaviconfinal.png' | asset_url }}" alt="FLOW3R" class="age-gate-logo-img">
      </div>
      <div class="age-gate-rule"></div>
      <h2 class="age-gate-heading">You must be {{ settings.age_gate_minimum }}+ to enter.</h2>
      <p class="age-gate-sub">This site sells products intended for adults only.</p>
      <div class="age-gate-btns">
        <button class="age-gate-enter" onclick="ageGateEnter()">I am {{ settings.age_gate_minimum }}+</button>
        <button class="age-gate-exit" onclick="ageGateExit()">I am under {{ settings.age_gate_minimum }}</button>
      </div>
      <p class="age-gate-legal">By entering you confirm you are of legal age in your jurisdiction.</p>
    </div>
  </div>
  {%- endif -%}

  <!-- ═══ ANNOUNCEMENT BAR — calm crossfade ═══ -->
  <div class="f-annbar" aria-label="Site announcements">
    <div class="f-annbar-rail">
      <span class="f-annbar-line">Free shipping over $75</span>
      <span class="f-annbar-line">Borosilicate glass only</span>
      <span class="f-annbar-line">Discreet plain packaging</span>
      <span class="f-annbar-line">1-Year guarantee</span>
      <span class="f-annbar-line">
        <span class="f-ann-desktop">A portion of Cat Collection sales is donated to California cat rescue</span>
        <span class="f-ann-mobile">A portion of sales supports cat rescue</span>
      </span>
    </div>
  </div>
 <style>
    .f-annbar{
      position:fixed;
      top:0;
      left:0;
      right:0;
      z-index:300;
      min-height:var(--ann);
      background:#245034;
      color:#fff;
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
    }
    .f-annbar-rail{
      position:relative;
      width:100%;
    }
    .f-annbar-line{
      position:absolute;
      top:0;
      left:0;
      right:0;
      min-height:var(--ann);
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      padding:4px 16px;
      font-size:11px;
      font-weight:500;
      letter-spacing:.12em;
      line-height:1.3;
      text-transform:uppercase;
      opacity:0;
      animation:fAnnFade 25s infinite;
    }
    .f-annbar-line:nth-child(1){position:relative;animation-delay:0s}
    .f-annbar-line:nth-child(2){animation-delay:5s}
    .f-annbar-line:nth-child(3){animation-delay:10s}
    .f-annbar-line:nth-child(4){animation-delay:15s}
    .f-annbar-line:nth-child(5){animation-delay:20s}
    @keyframes fAnnFade{
      0%{opacity:0}
      2%{opacity:1}
      18%{opacity:1}
      20%{opacity:0}
      100%{opacity:0}
    }
    .f-ann-mobile{ display:none; }
    .f-ann-desktop{ display:inline; }
    @media (max-width:600px){
      .f-annbar-line{ font-size:10px; letter-spacing:.06em; }
      .f-ann-desktop{ display:none; }
      .f-ann-mobile{ display:inline; }
    }
    @media (prefers-reduced-motion: reduce){
      .f-annbar-line{animation:none;opacity:0}
      .f-annbar-line:nth-child(1){opacity:1;position:relative}
    }
  </style>

  <!-- ═══ HEADER / NAV ═══ -->
